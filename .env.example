# OBRIGATÓRIO: segredo de 32+ caracteres que criptografa a sessão (gere com: openssl rand -base64 48)
SESSION_SECRET=
# Use "production" em HTTPS (ativa cookie Secure). Na Vercel, defina também.
NODE_ENV=production
# URL-base da API DuckMail (padrão oficial)
DUCKMAIL_API_URL=https://api.duckmail.sbs
# Na Vercel use 1 (necessário para o limite de tentativas por IP)
TRUST_PROXY=1
# Apenas local
PORT=3000
